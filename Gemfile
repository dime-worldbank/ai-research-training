source "https://rubygems.org"

# Minimal set for building the site outside GitHub Pages (e.g. Netlify).
# Versions match what GitHub Pages uses (Jekyll 3.10, Cayman via remote_theme).
gem "jekyll", "~> 3.10"
gem "jekyll-remote-theme"
gem "jekyll-seo-tag"
gem "jekyll-theme-cayman"
gem "kramdown-parser-gfm"
gem "webrick"
